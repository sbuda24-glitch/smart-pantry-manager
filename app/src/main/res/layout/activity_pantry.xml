
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F5F7EF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Pantry"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#285943"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/ingredientName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ingredient name"
        android:inputType="textCapSentences"
        android:singleLine="true" />

    <EditText
        android:id="@+id/ingredientQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity (e.g. 2)"
        android:inputType="numberDecimal"
        android:singleLine="true" />

    <EditText
        android:id="@+id/ingredientUnit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Unit (e.g. kg, cups, pieces)"
        android:inputType="textCapSentences"
        android:singleLine="true" />

    <EditText
        android:id="@+id/ingredientExpiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Expiry date (YYYY-MM-DD, optional)"
        android:inputType="date"
        android:singleLine="true" />

    <Button
        android:id="@+id/addIngredientButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Ingredient"
        android:textAllCaps="false"
        android:backgroundTint="#285943"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/suggestedRecipesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Suggested Recipes" />


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ingredients"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#285943"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp" />

    <ListView
        android:id="@+id/ingredientList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#D8DFD2"
        android:dividerHeight="1dp" />

</LinearLayout>
